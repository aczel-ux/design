<dialog
  class="m-auto max-h-[90vh] max-w-[90vw] overflow-visible bg-transparent p-0 backdrop:bg-black/80"
  data-image-lightbox
>
  <div class="relative">
    <form method="dialog">
      <button
        class="absolute -right-3 -top-3 z-10 grid h-10 w-10 place-items-center rounded-full bg-white text-2xl leading-none text-ink shadow-lg transition hover:bg-mist focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
        type="submit"
        aria-label="Close image preview"
      >
        <span aria-hidden="true">×</span>
      </button>
    </form>
    <figure
      class="max-h-[90vh] max-w-[90vw] overflow-auto rounded-2xl bg-white p-3 shadow-2xl sm:p-4"
    >
      <img class="max-h-[78vh] max-w-full rounded-xl object-contain" alt="" data-lightbox-preview />
      <figcaption
        class="mt-3 max-w-4xl text-center text-sm leading-6 text-ink/70"
        data-lightbox-caption
        hidden
      >
      </figcaption>
    </figure>
  </div>
</dialog>

<script>
  const lightbox = document.querySelector<HTMLDialogElement>('[data-image-lightbox]');
  const preview = lightbox?.querySelector<HTMLImageElement>('[data-lightbox-preview]');
  const caption = lightbox?.querySelector<HTMLElement>('[data-lightbox-caption]');

  function isLightboxImage(target: EventTarget | null): target is HTMLImageElement {
    return target instanceof HTMLImageElement && target.hasAttribute('data-lightbox-image');
  }

  function openLightbox(target: HTMLImageElement) {
    if (!lightbox || !preview || !caption) return;

    preview.src = target.currentSrc || target.src;
    preview.alt = target.alt;
    caption.textContent = target.dataset.lightboxCaption || target.alt;
    caption.hidden = !caption.textContent;
    lightbox.showModal();
  }

  document.addEventListener('click', (event) => {
    if (isLightboxImage(event.target)) openLightbox(event.target);
  });

  document.addEventListener('keydown', (event) => {
    if ((event.key === 'Enter' || event.key === ' ') && isLightboxImage(event.target)) {
      event.preventDefault();
      openLightbox(event.target);
    }
  });

  lightbox?.addEventListener('click', (event) => {
    if (event.target === lightbox) lightbox.close();
  });
</script>
