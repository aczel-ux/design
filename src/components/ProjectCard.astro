---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../lib/site';
interface Props {
  project: CollectionEntry<'projects'>;
  priority?: boolean;
  compact?: boolean;
  surface?: 'white' | 'mist';
}
const { project, priority = false, compact = false, surface = 'white' } = Astro.props;
---

<article class="group h-full">
  <a
    class:list={[
      'project-card-link flex h-full flex-col overflow-hidden rounded-3xl focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-aqua',
      surface === 'mist' ? 'bg-mist' : 'bg-white',
    ]}
    href={withBase(`/projects/${project.id}/`)}
    aria-label={`View ${project.data.title} case study`}
  >
    <div class:list={['aspect-[4/3] overflow-hidden', surface === 'mist' ? 'bg-mist' : 'bg-white']}>
      <Image
        class="h-full w-full bg-transparent object-cover transition-transform duration-500 ease-out group-hover:scale-[1.02]"
        style="background-color: transparent"
        src={project.data.cover}
        alt={project.data.coverAlt}
        widths={[480, 768, 1100]}
        sizes={compact
          ? '(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw'
          : '(min-width: 768px) 50vw, 100vw'}
        loading={priority ? 'eager' : 'lazy'}
      />
    </div>
    <div class:list={[compact ? 'p-5' : 'p-6', 'flex flex-1 flex-col']}>
      <h3 class:list={[compact ? 'text-xl' : 'text-2xl', 'font-semibold tracking-[-0.025em]']}>
        {project.data.title}
      </h3>
      <p
        class:list={[compact ? 'mt-2 leading-6' : 'mt-3 leading-7', 'max-w-xl text-sm text-ink/70']}
      >
        {project.data.summary}
      </p>
    </div>
  </a>
</article>
