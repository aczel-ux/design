---
import Container from './ui/Container.astro';
import { site } from '../lib/site';
---

<footer class="border-t border-line bg-white py-12">
  <Container class="grid gap-10 text-sm sm:grid-cols-2 lg:grid-cols-[1fr_1fr_auto]">
    <div>
      <h2 class="text-xs font-extrabold tracking-[0.08em]">FOLLOW ME</h2>
      <div class="mt-4 flex flex-col items-start gap-2">
        <a class="hover:text-aqua-dark" href={site.behance} target="_blank" rel="noreferrer">
          on Behance
        </a>
        <a class="hover:text-aqua-dark" href={site.linkedin} target="_blank" rel="noreferrer">
          on LinkedIn
        </a>
      </div>
    </div>
    <div>
      <h2 class="text-xs font-extrabold tracking-[0.08em]">CONTACT INFO</h2>
      <p class="mt-4">
        e-mail: <a class="hover:text-aqua-dark" href={`mailto:${site.email}`}>{site.email}</a>
      </p>
      <p class="mt-2">
        phone: <a class="hover:text-aqua-dark" href={site.phoneHref}>{site.phone}</a>
      </p>
    </div>
    <p class="self-end text-ink/55">© {new Date().getFullYear()} by {site.person}</p>
  </Container>
</footer>
