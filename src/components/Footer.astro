---
import { Mail, Phone } from '@lucide/astro';
import Container from './ui/Container.astro';
import BrandIcon from './ui/BrandIcon.astro';
import { site, withBase } from '../lib/site';
---

<footer class="border-t border-white/10 bg-neutral text-neutral-content">
  <Container class="grid gap-12 py-14 md:grid-cols-[1fr_auto] md:items-end lg:py-20">
    <div>
      <p class="eyebrow !text-[#9fcacc]">Independent designer · Budapest / Remote</p>
      <p class="mt-5 max-w-3xl text-3xl font-light tracking-[-0.04em] sm:text-5xl">
        Let’s make something useful, clear and lovable.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          class="btn rounded-full bg-white text-neutral hover:bg-mist"
          href={`mailto:${site.email}`}><Mail size={18} />{site.email}</a
        >
        <a class="btn btn-ghost rounded-full text-white" href={site.phoneHref}
          ><Phone size={18} />{site.phone}</a
        >
      </div>
    </div>
    <div class="flex gap-2">
      <a
        class="btn btn-circle btn-ghost"
        href={site.behance}
        target="_blank"
        rel="noreferrer"
        aria-label="Behance"><BrandIcon brand="behance" /></a
      >
      <a
        class="btn btn-circle btn-ghost"
        href={site.linkedin}
        target="_blank"
        rel="noreferrer"
        aria-label="LinkedIn"><BrandIcon brand="linkedin" /></a
      >
    </div>
  </Container>
  <Container
    class="flex flex-col gap-3 border-t border-white/10 py-6 text-sm text-white/55 sm:flex-row sm:items-center sm:justify-between"
  >
    <p>© {new Date().getFullYear()} {site.person}</p>
    <div class="flex gap-5">
      <a class="hover:text-white" href={withBase('/about/')}>About</a><a
        class="hover:text-white"
        href={withBase('/component-library/')}>Design system</a
      >
    </div>
  </Container>
</footer>
