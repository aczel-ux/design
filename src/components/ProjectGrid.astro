---
import type { CollectionEntry } from 'astro:content';
import ProjectCard from './ProjectCard.astro';
interface Props {
  projects: CollectionEntry<'projects'>[];
}
const { projects } = Astro.props;
---

<div class="grid gap-x-7 gap-y-14 md:grid-cols-2 lg:gap-x-10 lg:gap-y-20">
  {projects.map((project, index) => <ProjectCard project={project} priority={index < 2} />)}
</div>
