---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import ContactSection from '../components/ContactSection.astro';
import HighlightedText from '../components/ui/HighlightedText.astro';
interface Props {
  title: string;
  titleHighlights?: string[];
  description: string;
  projects: CollectionEntry<'projects'>[];
  introHeading?: string;
  groups?: Array<{
    title: string;
    subtitle?: string;
    description?: string;
    projectIds: string[];
  }>;
}
const { title, titleHighlights = [], description, projects, introHeading, groups } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <section class="py-20 sm:py-28">
    <Container>
      <h1 class="display max-w-5xl">
        <HighlightedText text={title} highlights={titleHighlights} />
      </h1>
      <p class="mt-7 max-w-[39rem] text-base leading-7 text-ink/75">{description}</p>
    </Container>
  </section>
  {
    groups ? (
      groups.map((group, index) => {
        const groupProjects = group.projectIds.flatMap((id) => {
          const project = projects.find((entry) => entry.id === id);
          return project ? [project] : [];
        });
        return (
          <section class:list={['py-18 sm:py-24', index % 2 === 0 ? 'bg-mist' : 'bg-white']}>
            <Container>
              <h2 class="headline">{group.title}</h2>
              {group.subtitle && (
                <p class="mt-3 text-sm font-bold text-aqua-dark">{group.subtitle}</p>
              )}
              {group.description && (
                <p class="mt-5 max-w-[39rem] leading-7 text-ink/75">{group.description}</p>
              )}
              <div class="mt-12">
                <ProjectGrid
                  projects={groupProjects}
                  cardSurface={index % 2 === 0 ? 'white' : 'mist'}
                />
              </div>
            </Container>
          </section>
        );
      })
    ) : (
      <section class="bg-mist py-18 sm:py-24">
        <Container>
          {introHeading && <h2 class="headline mb-12">{introHeading}</h2>}
          <ProjectGrid projects={projects} />
        </Container>
      </section>
    )
  }
  <ContactSection />
</BaseLayout>
