---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../lib/site';
interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}
const { title = site.name, description = site.description, image, noindex = false } = Astro.props;
const pageTitle =
  title === site.name ? `${site.person} — UX/UI & Graphic Designer` : `${title} — ${site.person}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = image
  ? new URL(image, Astro.site)
  : new URL(`${import.meta.env.BASE_URL}og-default.svg`, Astro.site);
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.person,
  url: canonical.origin,
  jobTitle: 'UX/UI and Graphic Designer',
  address: { '@type': 'PostalAddress', addressLocality: 'Budapest', addressCountry: 'HU' },
  sameAs: [site.behance, site.linkedin],
  email: `mailto:${site.email}`,
};
---

<!doctype html>
<html lang="en" data-theme="aczel">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a
      href="#main"
      class="sr-only z-[100] rounded bg-white p-3 focus:not-sr-only focus:fixed focus:left-4 focus:top-4"
      >Skip to content</a
    >
    <Header />
    <main id="main"><slot /></main>
    <Footer />
  </body>
</html>
