---
import { Download } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Button from '../components/ui/Button.astro';
import ContactSection from '../components/ContactSection.astro';
import { withBase } from '../lib/site';
---

<BaseLayout
  title="About"
  description="About Dániel Z. Aczél, a senior UX/UI and graphic designer based in Budapest and working internationally."
>
  <section class="py-20 sm:py-28">
    <Container>
      <h1 class="display">About me</h1>
      <div class="mt-9 max-w-[39rem] space-y-6 leading-7 text-ink/75">
        <p>
          I am a UX designer specializing in mobile application design and websites, but I also
          enjoy logo and brand identity design, packaging and other graphic design work. I am based
          in Budapest, Hungary, and take on projects remotely around the world.
        </p>
        <p>
          I like working in cross-functional teams with experts from different backgrounds, while
          remaining comfortable owning smaller projects independently. I am experienced in agile
          environments and always open to trying new processes and refining my workflow.
        </p>
        <p>
          I place great emphasis on inclusive design and accessibility, and believe that good design
          can make our lives better.
        </p>
      </div>
      <Button class="mt-8" href={withBase('/downloads/daniel-aczel-cv.pdf')} variant="secondary">
        <Download size={17} />Download CV in PDF
      </Button>
    </Container>
  </section>

  <section class="bg-mist py-20 sm:py-28">
    <Container class="grid gap-14 lg:grid-cols-3">
      <article>
        <h2 class="headline">What I work with</h2>
        <div class="mt-6 space-y-5 text-sm leading-7 text-ink/72">
          <p>Tools change, and part of my job is finding the right one for the problem.</p>
          <p><strong>Design:</strong> Figma, Sketch, Abstract, Miro and Adobe Creative Cloud</p>
          <p><strong>Collaboration:</strong> Jira, Confluence, Trello and GitHub</p>
          <p>
            I can write HTML and CSS and understand how web, native and cross-platform products
            behave.
          </p>
        </div>
      </article>
      <article>
        <h2 class="headline">How I work</h2>
        <div class="mt-6 space-y-5 text-sm leading-7 text-ink/72">
          <p>
            I have worked in agile and waterfall environments, including Kanban and sprint-based
            teams.
          </p>
          <p>
            I collaborate with researchers, developers, writers, artists and product managers, and
            facilitate workshops that involve them in the design process.
          </p>
          <p>
            Whenever possible, I base decisions on qualitative and quantitative research rather than
            assumptions.
          </p>
        </div>
      </article>
      <article>
        <h2 class="headline">What I believe in</h2>
        <div class="mt-6 space-y-5 text-sm leading-7 text-ink/72">
          <p>
            Products should be useful and enjoyable, with a positive impact on the people who use
            them.
          </p>
          <p>
            Modern products should serve people regardless of their abilities. Accessibility is part
            of design quality from the beginning.
          </p>
        </div>
      </article>
    </Container>
  </section>
  <ContactSection />
</BaseLayout>
