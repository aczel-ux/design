---
import { getCollection } from 'astro:content';
import { ArrowDown, Layers, PenTool, Shapes } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Button from '../components/ui/Button.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import ContactSection from '../components/ContactSection.astro';
import { withBase } from '../lib/site';
const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
const featured = projects.filter((project) => project.data.featured).slice(0, 6);
const services = [
  {
    icon: Layers,
    title: 'Product design',
    text: 'Research-driven UX/UI for mobile and web products, from early product-market fit to mature platforms.',
    href: '/ux-ui/',
  },
  {
    icon: Shapes,
    title: 'Design systems',
    text: 'Scalable foundations, components and contribution models that keep design and development aligned.',
    href: '/consultation/',
  },
  {
    icon: PenTool,
    title: 'Brand & visual design',
    text: 'Logos, identity systems, websites, packaging and editorial work with a clear point of view.',
    href: '/brand-logo/',
  },
];
---

<BaseLayout>
  <section class="relative overflow-hidden py-20 sm:py-28 lg:py-36">
    <div
      class="pointer-events-none absolute -right-40 top-12 h-[30rem] w-[30rem] rounded-full bg-secondary/55 blur-3xl"
    >
    </div>
    <Container class="relative">
      <p class="eyebrow">Senior UX/UI & graphic designer · Budapest</p>
      <h1 class="display mt-6 max-w-6xl">
        Clear products.<br /><span class="text-aqua">Lovable</span> experiences.
      </h1>
      <div class="mt-10 grid gap-8 lg:grid-cols-[1fr_0.7fr] lg:items-end">
        <p class="max-w-2xl text-xl font-medium leading-9 text-ink/72 sm:text-2xl">
          I design mobile apps, websites, design systems and brand identities for teams that care
          about how their products work and feel.
        </p>
        <div class="flex flex-wrap gap-3 lg:justify-end">
          <Button href={withBase('/#work')} size="lg"
            >Explore selected work <ArrowDown size={18} /></Button
          ><Button href={withBase('/about/')} variant="secondary" size="lg">About me</Button>
        </div>
      </div>
    </Container>
  </section>

  <section id="work" class="scroll-mt-24 border-t border-line py-20 sm:py-28">
    <Container>
      <div class="mb-12 flex items-end justify-between gap-6">
        <div>
          <p class="eyebrow">Selected work</p><h2 class="headline mt-4">Case studies</h2>
        </div><Button href={withBase('/ux-ui/')} variant="ghost" icon>View all work</Button>
      </div>
      <ProjectGrid projects={featured} />
    </Container>
  </section>

  <section class="bg-neutral py-20 text-neutral-content sm:py-28">
    <Container>
      <p class="eyebrow !text-[#9fcacc]">What I do</p>
      <h2 class="headline mt-4 max-w-4xl">
        From product strategy to the final pixel—and the system behind it.
      </h2>
      <div
        class="mt-14 grid gap-px overflow-hidden rounded-[1.5rem] border border-white/12 bg-white/12 md:grid-cols-3"
      >
        {
          services.map(({ icon: Icon, title, text, href }) => (
            <a class="group bg-neutral p-7 hover:bg-white/[0.06] sm:p-9" href={withBase(href)}>
              <>
                <Icon class="text-[#9fcacc]" size={30} stroke-width={1.6} />
                <h3 class="mt-10 text-2xl font-medium tracking-[-0.03em]">{title}</h3>
                <p class="mt-3 leading-7 text-white/62">{text}</p>
                <span class="mt-8 inline-block text-sm font-semibold text-[#9fcacc] group-hover:text-white">
                  Explore →
                </span>
              </>
            </a>
          ))
        }
      </div>
    </Container>
  </section>
  <ContactSection />
</BaseLayout>
