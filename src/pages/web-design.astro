---
import { getCollection } from 'astro:content';
import CategoryLayout from '../layouts/CategoryLayout.astro';
const projects = (
  await getCollection('projects', ({ data }) => data.category === 'web-design' && !data.draft)
).sort((a, b) => a.data.order - b.data.order);
---

<CategoryLayout
  title="Web Design Projects"
  titleHighlights={['Web']}
  introHeading="Websites and Progressive Web Apps"
  description="I design websites and digital interfaces for companies of all sizes—from focused, high-converting landing pages to complex forums and admin dashboards. My projects range from standalone web experiences to full brand redesigns, always focused on usability, visual clarity and cohesive experiences that support both business goals and user needs."
  projects={projects}
/>
