---
import { Blocks, MessageSquareMore, Workflow } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Button from '../components/ui/Button.astro';
import ContactSection from '../components/ContactSection.astro';
import HighlightedText from '../components/ui/HighlightedText.astro';
import { withBase } from '../lib/site';
const topics = [
  {
    icon: MessageSquareMore,
    title: 'UX / UI Product Review',
    text: 'I provide detailed, practical reviews of digital products—identifying usability issues, visual inconsistencies and opportunities to improve the overall experience. Each review delivers clear, actionable feedback aligned with user and business goals.',
  },
  {
    icon: Blocks,
    title: 'Design System Coaching',
    text: 'I help teams plan, build and maintain design systems that fit their product and workflow. From foundations and components to documentation and collaboration, the aim is a scalable system that improves consistency, speed and quality.',
  },
  {
    icon: Workflow,
    title: 'Design Ops Consulting',
    text: 'I work with teams to improve how design integrates into their workflow. By refining processes, tools and collaboration across design, product and development, I help create a more effective and predictable design operation.',
  },
];
---

<BaseLayout
  title="Expert Design Consultation"
  description="Hands-on UX reviews, design-system coaching and design-operations consultation for product teams."
>
  <section class="py-20 sm:py-28">
    <Container>
      <h1 class="display">
        Expert <HighlightedText text="Consultation" highlights={['Consultation']} />
      </h1>
      <p class="mt-7 max-w-[39rem] leading-7 text-ink/75">
        I offer hands-on design consultation for teams and companies looking to strengthen their
        design practice. Whether reviewing a product and providing actionable UX feedback, improving
        design operations, or helping build a scalable component library and design system, I tailor
        my approach to each team’s needs. The goal is always the same: smoother design processes,
        more consistent products and more confident teams.
      </p>
    </Container>
  </section>
  <section class="bg-mist py-20 sm:py-28">
    <Container>
      <h2 class="headline">Topics for Expert Consultation</h2>
      <div class="mt-14 grid gap-x-10 gap-y-14 md:grid-cols-3">
        {
          topics.map(({ icon: Icon, title, text }) => (
            <article>
              <Icon class="text-aqua" size={30} stroke-width={1.5} />
              <h3 class="mt-6 text-2xl font-semibold">{title}</h3>
              <p class="mt-4 text-sm leading-7 text-ink/70">{text}</p>
              <Button class="mt-6" href={withBase('/#contact')} variant="secondary">
                Ask for an offer
              </Button>
            </article>
          ))
        }
      </div>
    </Container>
  </section>
  <ContactSection />
</BaseLayout>
